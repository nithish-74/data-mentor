# Copy this file to .env and fill in the two keys. Never share .env.

# From @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free-tier models, tried in order (comma-separated). Lite models are fastest on the free tier.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Daily reminder (24h clock) and your timezone
REMINDER_TIME=07:00
TIMEZONE=Asia/Kolkata

# Use Google Search grounding for lessons/chat (latest docs). Set false if you hit search quota limits.
SEARCH_IN_LESSONS=false

# Optional: lock the bot to your chat id. If empty, the first person to send /start becomes the owner.
ALLOWED_CHAT_ID=

# ---- Website ----
WEB_PORT=8000
# This username is always admin (otherwise the first person to join is admin)
ADMIN_USERNAME=
# true = new usernames need an invite code from the admin; false = anyone can pick a username
REQUIRE_INVITE=false
PUBLIC_URL=http://localhost:8000
# Max AI requests per person per day (protects the shared free quota)
DAILY_AI_LIMIT=40

# ---- OpenRouter fallback (optional) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_GRADER_MODEL=

# ---- Going public ----
ADMIN_PASSWORD=
TUNNEL=false
GLOBAL_DAILY_AI_LIMIT=500
NEW_USERS_PER_IP_PER_DAY=5

# ---- Permanent link for the app + notifications (free ngrok account) ----
# ngrok.com: Domains -> claim your free static domain; Your Authtoken -> copy. Then restart the mentor.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
